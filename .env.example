# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is gitignored.

# --- LeetCode ---------------------------------------------------------------
# Your public LeetCode username (not email). The check reads the daily
# problem and your public recent submissions — no login, no password,
# no session. Any number of workers and devices coexist.
LEETCODE_USERNAME=your_public_username

# --- Telegram (required only when using --notify) ---------------------------
# 1. Create a bot with @BotFather → bot token
# 2. Message the bot (/start), then get your chat id (@userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=123456789
